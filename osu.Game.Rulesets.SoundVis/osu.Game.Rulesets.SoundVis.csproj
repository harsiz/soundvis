<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>osu.Game.Rulesets.SoundVis</RootNamespace>
    <AssemblyName>osu.Game.Rulesets.SoundVis</AssemblyName>
  </PropertyGroup>

  <!--
    We compile against the INSTALLED osu!lazer assemblies rather than the ppy.osu.Game
    NuGet package.

    Reason: lazer ships breaking API changes well before they reach NuGet. As of
    2026-08-20 the game is 2026.819.0 while the newest package is 2026.730.0, and the
    two disagree in ways that cannot both be satisfied from one source file — e.g.
    RulesetSettingsSubsection.Header is *abstract* in 730 (override required) but
    *sealed* in 819 (override forbidden). Building against NuGet therefore produces a
    ruleset that cannot load into the installed game.

    Override the path with -p:OsuGamePath=... if lazer lives elsewhere.
    Private=false keeps these out of our build output - the game supplies them.
  -->
  <PropertyGroup>
    <OsuGamePath Condition="'$(OsuGamePath)' == ''">$(LOCALAPPDATA)\osulazer\current</OsuGamePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="osu.Game">
      <HintPath>$(OsuGamePath)\osu.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="osu.Framework">
      <HintPath>$(OsuGamePath)\osu.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="osuTK">
      <HintPath>$(OsuGamePath)\osuTK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Realm">
      <HintPath>$(OsuGamePath)\Realm.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/**" />
  </ItemGroup>
</Project>
